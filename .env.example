# ─────────────────────────────────────────────────────────────────────────────
# CLIENT vars (VITE_ prefix)
#
# WARNING: every VITE_ value is inlined into the JavaScript bundle and is public.
# Never put a secret here — API keys with billing, database tokens, OAuth tokens
# and app secrets all belong in the server section below.
# ─────────────────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Content Studio — presence of this URL is what enables the Content Studio UI.
# It is not a credential; the auth token is server-side (see TURSO_TOKEN below).
VITE_TURSO_DATABASE_URL=libsql://your-db.turso.io

# Second Firebase project used by the Topz Cab module
VITE_TOPZ_API_KEY=
VITE_TOPZ_AUTH_DOMAIN=
VITE_TOPZ_PROJECT_ID=
VITE_TOPZ_STORAGE_BUCKET=
VITE_TOPZ_MESSAGING_SENDER_ID=
VITE_TOPZ_APP_ID=

# Cloudinary (unsigned upload preset — safe to expose)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ─────────────────────────────────────────────────────────────────────────────
# SERVER vars (NO VITE_ prefix) — set these in the Vercel project settings.
# They are never bundled and are only readable from api/ functions.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase project id, used by api/lib/verify-auth.ts to validate ID tokens.
# Falls back to VITE_FIREBASE_PROJECT_ID if unset.
FIREBASE_PROJECT_ID=your_project_id

# Turso / libSQL — required by api/topz-*.ts and api/content-studio-db.ts.
# Without these the Topz endpoints and Content Studio return 500.
TURSO_URL=libsql://your-db.turso.io
TURSO_TOKEN=your_turso_auth_token

# Mappls distance API — used by api/distance.ts (falls back to OSRM if unset)
MAPPLS_KEY=

# Comma-separated origins allowed to call the api/ functions.
# e.g. http://localhost:5173,https://your-app.vercel.app
ALLOWED_ORIGINS=

# Content Studio social sync — optional; leave a platform's vars unset to keep it
# "Not connected". Read only by api/social-proxy.ts.
YT_API_KEY=
YT_CHANNEL_ID=
YT_BRAND_ID=
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_BRAND_ID=
FB_ACCESS_TOKEN=
FB_PAGE_ID=
FB_APP_ID=
FB_APP_SECRET=
FB_BRAND_ID=
LI_ACCESS_TOKEN=
LI_ORG_ID=
LI_BRAND_ID=
LI_VERSION=
