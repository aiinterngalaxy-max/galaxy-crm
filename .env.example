VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_ANTHROPIC_API_KEY=your_anthropic_key_here

# Content Studio — AI video auto-edit (Editing stage → "Video" button).
# No env var needed by default: footage is stored via the same per-user
# Google Drive upload as Documents Upload (see below), and the auto-edit
# itself runs client-side in the browser via ffmpeg.wasm — no external API,
# no key.
#
# Optional: GPU-accelerated rendering. If both of these are set AND the
# render server is reachable (in practice: the visitor's own device is on
# the same private Tailscale network the server lives on), Content Studio
# transparently routes rendering there instead of the in-browser ffmpeg.wasm
# path — same editing features, faster, and with explicit encoder quality
# settings instead of ffmpeg's un-tuned defaults. Anyone not on that network
# falls back to the normal in-browser path automatically; nothing breaks if
# these are unset or the server is off. See src/lib/content-studio/
# remoteFFmpeg.ts and render-server/ (the server-side code, deployed
# separately — not part of the Vercel build).
VITE_RENDER_SERVER_URL=
VITE_RENDER_API_KEY=

# Accounts — Documents Upload storage. Each user grants their own Drive access
# via the same Google sign-in the app already uses (see src/lib/googleDriveAuth.ts) —
# no server-side secret, and no env var needed here. The app creates its own
# "Galaxy CRM Documents" folder in whichever Google account uploads the first
# file, and remembers that folder's ID per person (see src/lib/googleDrive.ts).

# Content Studio — direct Turso/libSQL access (same DB as galaxy-cmo-dashboard)
VITE_TURSO_DATABASE_URL=libsql://your-db.turso.io
VITE_TURSO_AUTH_TOKEN=your_turso_auth_token

# Content Studio — social sync (optional, leave unset to keep a platform "Not connected")
VITE_YT_API_KEY=
VITE_YT_CHANNEL_ID=
VITE_YT_BRAND_ID=
VITE_IG_ACCESS_TOKEN=
VITE_IG_USER_ID=
VITE_IG_BRAND_ID=
VITE_FB_ACCESS_TOKEN=
VITE_FB_PAGE_ID=
VITE_FB_BRAND_ID=
VITE_LI_ACCESS_TOKEN=
VITE_LI_ORG_ID=
VITE_LI_BRAND_ID=
VITE_LI_VERSION=
